{
  "name": "sharehope-server",
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon src/server.js",
    "dev:local": "nodemon src/server.js --db=local",
    "dev:atlas": "nodemon src/server.js --db=atlas",
    "start": "node src/server.js",
    "start:local": "node src/server.js --db=local",
    "start:atlas": "node src/server.js --db=atlas",
    "seed": "node src/seeds/seed.js",
    "seed:local": "node src/seeds/seed.js --target=local",
    "seed:atlas": "node src/seeds/seed.js --target=atlas --yes",
    "db:check": "node src/scripts/dbCheck.js",
    "test": "jest --runInBand --forceExit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.11",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "setupFiles": [
      "<rootDir>/src/__tests__/helpers/env.js"
    ]
  },
  "engines": {
    "node": ">=18"
  }
}
