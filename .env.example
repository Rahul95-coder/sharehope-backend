# ============================================================================
# ShareHope server configuration - copy this file to ".env" and fill it in.
#   Windows:  copy .env.example .env        Mac/Linux:  cp .env.example .env
# ============================================================================
NODE_ENV=development
PORT=5000

# ---- Database ---------------------------------------------------------------
# auto  = Atlas first, local MongoDB as fallback (fallback is development-only)
# atlas = Atlas only      local = local MongoDB only
# Override per run:  npm run dev:local   /   npm run dev:atlas
DB_MODE=auto
MONGODB_DB_NAME=sharehope

# MongoDB Atlas -> Connect -> Drivers. Put the database name before "?"
# URL-encode special characters in the password: @=%40  :=%3A  /=%2F  ?=%3F  #=%23  %=%25
MONGODB_ATLAS_URI=mongodb+srv://<db_user>:<url-encoded-password>@<cluster>.mongodb.net/sharehope?retryWrites=true&w=majority

# Local MongoDB (mongod on your computer)
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017/sharehope

# Production hosts (Render etc.) can set a single MONGODB_URI instead of the two above.
# MONGODB_URI=

# Used by `npm test` ONLY. Must be a throw-away local database, never Atlas.
# MONGODB_TEST_URI=mongodb://127.0.0.1:27017/sharehope_test

# ---- Security -----------------------------------------------------------------
# Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend origin(s) allowed to call the API (exact match, comma separated)
CLIENT_URL=http://localhost:5173
# ALLOW_NETLIFY_PREVIEWS=false
# TRUST_PROXY=1            # production behind Render/NGINX (default 1 in production)

# ---- Seed data (npm run seed) ------------------------------------------------------
SEED_ADMIN_EMAIL=admin@sharehope.org
SEED_ADMIN_PASSWORD=ChangeMe@12345

# ---- Uploads ------------------------------------------------------------------------
MAX_FILE_SIZE=10485760
# Set all three to store uploads in Cloudinary instead of server/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Background jobs ------------------------------------------------------------------
EXPIRY_CHECK_CRON=*/15 * * * *
NOTIFICATION_CRON=0 8 * * *
